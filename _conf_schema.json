{
    "setu_general": {
        "description": "色图基础行为",
        "type": "object",
        "hint": "色图核心请求和提供者策略设置。",
        "items": {
            "api_type": {
                "type": "string",
                "description": "API 提供者类型",
                "hint": "all 同时使用内置 API。",
                "default": "lolicon",
                "options": ["lolicon", "atri", "sexnyan", "custom", "all"]
            },
            "multi_api_strategy": {
                "type": "string",
                "description": "多 API 策略",
                "hint": "当 api_type 为 all/custom 时生效。",
                "default": "round_robin",
                "options": ["round_robin", "random", "failover"]
            },
            "content_mode": {
                "type": "string",
                "description": "内容模式",
                "hint": "全年龄/成人/混合",
                "default": "sfw",
                "options": ["sfw", "r18", "mix"]
            },
            "max_count": {
                "type": "int",
                "description": "每次请求最大图片数",
                "hint": "单次命令的上限。",
                "default": 10,
                "slider": {"min": 1, "max": 10, "step": 1}
            },
            "max_replenish_rounds": {
                "type": "int",
                "description": "最大补图轮次",
                "hint": "图片 URL 下载暂时失败时，同一 URL 会先按该轮次短暂重试；仍失败才继续补图或返回无结果。",
                "default": 3,
                "slider": {"min": 1, "max": 3, "step": 1}
            },
            "tag_alias_templates": {
                "type": "template_list",
                "description": "标签别名模板",
                "hint": "可选覆盖项；添加后会优先使用这些模板化别名。",
                "default": [],
                "templates": {
                    "alias": {
                        "name": "标签别名",
                        "hint": "把多个别名映射到一个标准标签。",
                        "items": {
                            "canonical": {
                                "type": "string",
                                "description": "标准标签",
                                "default": "少女"
                            },
                            "aliases": {
                                "type": "list",
                                "description": "别名列表",
                                "hint": "每行一个别名。",
                                "default": ["girl", "girls"]
                            }
                        }
                    }
                }
            }
        }
    },
    "delivery": {
        "description": "发送模式",
        "type": "object",
        "hint": "消息发送和 R18 打包设置。",
        "items": {
            "send_mode": {
                "type": "string",
                "description": "发送模式",
                "hint": "auto 在图片数量>1时使用转发。",
                "default": "image",
                "options": ["image", "forward", "auto"]
            },
            "r18_docx_mode": {
                "type": "bool",
                "description": "R18 Docx 打包模式",
                "hint": "将 R18 图片打包到 docx 文件中。",
                "default": true
            },
            "auto_revoke_r18": {
                "type": "bool",
                "description": "自动撤回 R18 图片/文件",
                "hint": "发送 R18 分级内容后，是否自动撤回消息（mix 模式随机到 r18 也算）。",
                "default": false
            },
            "auto_revoke_delay": {
                "type": "int",
                "description": "R18 撤回延迟时间(秒)",
                "hint": "发送 R18 内容后多久自动撤回，默认 30 秒。",
                "default": 30
            },
            "napcat_stream_mode": {
                "type": "string",
                "description": "NapCat 流式上传",
                "hint": "disabled=不用流式上传，fallback=确认普通发送失败后流式重试，always=发送前优先流式上传。",
                "default": "fallback",
                "options": ["disabled", "fallback", "always"]
            }
        }
    },
    "html_card": {
        "description": "HTML 卡片包装",
        "type": "object",
        "hint": "将图片包装为防审查卡片。",
        "items": {
            "strategy": {
                "type": "string",
                "description": "HTML 卡片策略",
                "hint": "never=从不使用，fallback=确认发送失败时降级使用，always=总是使用。",
                "default": "fallback",
                "options": ["never", "fallback", "always"]
            },
            "card_padding": {
                "type": "int",
                "description": "卡片内边距",
                "hint": "值越小卡片越紧凑。",
                "default": 6,
                "slider": {"min": 6, "max": 30, "step": 1}
            },
            "card_gap": {
                "type": "int",
                "description": "卡片间距",
                "hint": "卡片之间的垂直间距。",
                "default": 6,
                "slider": {"min": 6, "max": 30, "step": 1}
            }
        }
    },
    "fortune": {
        "description": "今日运势",
        "type": "object",
        "hint": "基于 Setu 图片源的每日运势功能。",
        "items": {
            "enabled": {
                "type": "bool",
                "description": "启用今日运势",
                "hint": "是否启用今日运势功能。",
                "default": true
            },
            "api_type": {
                "type": "string",
                "description": "API 提供者类型",
                "hint": "今日运势独立的图片源配置。inherit 表示使用色图相同的配置。",
                "default": "inherit",
                "options": ["inherit", "lolicon", "atri", "sexnyan", "custom"]
            },
            "tags": {
                "type": "string",
                "description": "默认标签",
                "hint": "获取今日运势图片时的默认标签，如'少女,可爱'。留空则不使用标签。",
                "default": ""
            },
            "content_mode": {
                "type": "string",
                "description": "内容模式",
                "hint": "今日运势的图片内容分级。",
                "default": "sfw",
                "options": ["sfw", "r18", "mix"]
            },
            "allow_user_refresh": {
                "type": "bool",
                "description": "允许用户刷新",
                "hint": "是否允许普通用户自行刷新运势（否则仅管理员可刷新）。",
                "default": false
            },
            "auto_refresh": {
                "type": "bool",
                "description": "自动刷新",
                "hint": "第二天是否自动重新生成运势（否则保留前一天的运势）。",
                "default": true
            }
        }
    },
    "cache": {
        "description": "发送缓存",
        "type": "object",
        "hint": "图片会先流式下载到插件数据目录，再从本地文件发送，避免 original 大图进入内存。",
        "items": {
            "enabled": {
                "type": "bool",
                "description": "启用缓存",
                "hint": "开启后复用未过期的本地发送缓存；关闭后仍会落盘发送，但不复用旧文件。",
                "default": true
            },
            "ttl_hours": {
                "type": "int",
                "description": "缓存 TTL（小时）",
                "hint": "默认为 2 小时。",
                "default": 2
            },
            "max_items": {
                "type": "int",
                "description": "最大缓存图片数",
                "hint": "默认只保留 200 条图片缓存。",
                "default": 200
            },
            "cleanup_on_start": {
                "type": "bool",
                "description": "启动时清理",
                "hint": "插件启动时自动删除过期和溢出的条目。",
                "default": true
            }
        }
    },
    "api": {
        "description": "提供者详情",
        "type": "object",
        "hint": "提供者特定的设置。",
        "items": {
            "provider_overrides": {
                "type": "template_list",
                "description": "Provider 配置",
                "hint": "provider 专属配置；未添加对应模板时使用内置默认（original 尺寸、无代理）。",
                "default": [],
                "templates": {
                    "lolicon": {
                        "name": "Lolicon 配置",
                        "hint": "Lolicon 提供者的专属配置。",
                        "items": {
                            "image_size": {
                                "type": "string",
                                "description": "图片尺寸",
                                "default": "original",
                                "options": ["original", "regular", "small", "thumb", "mini"]
                            },
                            "proxy": {
                                "type": "string",
                                "description": "图片代理主机",
                                "default": ""
                            },
                            "aspect_ratio": {
                                "type": "string",
                                "description": "宽高比过滤",
                                "default": "",
                                "options": ["", "horizontal", "vertical", "square"]
                            },
                            "uid": {
                                "type": "list",
                                "description": "作者 UID 列表",
                                "hint": "每行一个 UID。",
                                "default": []
                            },
                            "keyword": {
                                "type": "string",
                                "description": "关键词过滤",
                                "default": ""
                            },
                            "exclude_ai": {
                                "type": "bool",
                                "description": "排除 AI 生成作品",
                                "default": true
                            }
                        }
                    },
                    "atri": {
                        "name": "Atri 配置",
                        "hint": "Atri 提供者的专属配置。",
                        "items": {
                            "image_size": {
                                "type": "string",
                                "description": "图片尺寸",
                                "default": "original",
                                "options": ["original", "regular", "small", "thumb", "mini"]
                            },
                            "proxy": {
                                "type": "string",
                                "description": "图片代理主机",
                                "default": ""
                            },
                            "aspect_ratio": {
                                "type": "string",
                                "description": "宽高比过滤",
                                "default": "",
                                "options": ["", "horizontal", "vertical", "square"]
                            },
                            "uid": {
                                "type": "list",
                                "description": "作者 UID 列表",
                                "hint": "每行一个 UID。",
                                "default": []
                            },
                            "keyword": {
                                "type": "string",
                                "description": "关键词过滤",
                                "default": ""
                            },
                            "exclude_ai": {
                                "type": "bool",
                                "description": "排除 AI 生成作品",
                                "default": true
                            }
                        }
                    }
                }
            },
            "custom_api_configs": {
                "type": "template_list",
                "description": "自定义 API 列表",
                "hint": "配置一个或多个自定义图片 API。",
                "default": [],
                "obvious_hint": true,
                "templates": {
                    "api_template": {
                        "name": "自定义 API",
                        "hint": "一个自定义 API 配置。",
                        "items": {
                            "name": {
                                "type": "string",
                                "description": "API 配置名称",
                                "default": "My custom API"
                            },
                            "url": {
                                "type": "string",
                                "description": "API 地址",
                                "hint": "支持 {num}、{r18}、{tags} 占位符。",
                                "default": "https://api.example.com/images?num={num}&tag={tags}"
                            },
                            "method": {
                                "type": "string",
                                "description": "HTTP 方法",
                                "default": "GET",
                                "options": ["GET", "POST"]
                            },
                            "timeout": {
                                "type": "int",
                                "description": "超时秒数",
                                "default": 30
                            },
                            "parser_type": {
                                "type": "string",
                                "description": "解析器类型",
                                "hint": "auto/json",
                                "default": "auto",
                                "options": ["auto", "json"]
                            },
                            "json_path": {
                                "type": "string",
                                "description": "JSON 路径",
                                "hint": "当 parser_type=json 时使用。示例：$.data[*].url",
                                "default": ""
                            }
                        }
                    }
                }
            }
        }
    },
    "messages": {
        "description": "提示消息覆盖",
        "type": "object",
        "hint": "默认使用内置提示；只在需要自定义某条提示时添加覆盖模板。",
        "items": {
            "message_overrides": {
                "type": "template_list",
                "description": "提示消息覆盖",
                "hint": "添加后按 message_key 覆盖对应内置提示文本。",
                "default": [],
                "templates": {
                    "message": {
                        "name": "提示消息",
                        "hint": "覆盖一条插件提示，可关闭或修改文本。",
                        "items": {
                            "message_key": {
                                "type": "string",
                                "description": "消息键",
                                "default": "fetching",
                                "options": [
                                    "fetching",
                                    "found",
                                    "send_failed",
                                    "rate_limited",
                                    "config_not_loaded",
                                    "invalid_count",
                                    "max_count_exceeded",
                                    "count_out_of_range",
                                    "fetch_timeout",
                                    "fetch_failed",
                                    "no_result",
                                    "empty_payload",
                                    "r18_docx_failed",
                                    "fortune_group_only",
                                    "fortune_missing_user_id",
                                    "fortune_get_failed",
                                    "fortune_refresh_failed",
                                    "fortune_refresh_group_failed",
                                    "fortune_refresh_all_failed",
                                    "fortune_refresh_group_done",
                                    "fortune_refresh_all_done",
                                    "fortune_enabled_group_done",
                                    "fortune_disabled_group_done",
                                    "fortune_block_user_done",
                                    "fortune_unblock_user_done",
                                    "fortune_trust_user_done",
                                    "fortune_untrust_user_done"
                                ]
                            },
                            "enabled": {
                                "type": "bool",
                                "description": "启用该提示",
                                "default": true
                            },
                            "text": {
                                "type": "string",
                                "description": "提示文本",
                                "hint": "可继续使用该消息原本支持的占位符。",
                                "default": "正在获取图片，请稍候..."
                            }
                        }
                    }
                }
            }
        }
    }
}
